{
  "name": "generative-42",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm build:wasm && vite",
    "build": "pnpm build:wasm && tsc && vite build",
    "build:wasm": "zig build && chmod 644 public/wasm/kernels.wasm",
    "test:wasm": "pnpm build:wasm && node wasm/test.mjs && tsx wasm/test-sort.ts && tsx wasm/test-detail.ts && tsx wasm/test-voronoi.ts && tsx wasm/test-mask.ts",
    "preview": "vite preview",
    "generate": "tsx generate/headless.ts",
    "generate:all": "tsx generate/headless.ts --all"
  },
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "puppeteer": "^23.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
